<%- include('partials/header') %>

<main class="page page-projects">
    <%- include('partials/page-banner', {
        title,
        eyebrow: 'Current Opportunities',
        subtitle: 'Discover projects that are ready for volunteers right now, from one-time events to recurring service opportunities.',
        bannerClass: 'page-banner--projects'
    }) %>

    <section class="content-intro">
        <h2>Featured service projects</h2>
        <p class="lead">Each project is designed to meet a real need while giving volunteers a clear path to show up, help, and make a visible difference.</p>
        <p>Browse a few upcoming opportunities below and choose the kind of service experience that best fits your time, energy, and interests.</p>
    </section>

    <section class="project-grid">
        <% if (projects.length > 0) { %>
            <% projects.forEach((project) => { %>
                <article class="project-card">
                    <h3>
                        <%= new Date(project.date).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                            timeZone: 'UTC'
                        }) %>:
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                        (<em><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></em>)
                    </h3>
                </article>
            <% }); %>
        <% } else { %>
            <p>No service projects are currently available.</p>
        <% } %>
    </section>

    <section class="section-panel">
        <h2>What to expect when you join a project</h2>
        <div class="info-grid">
            <article class="info-card">
                <h3>Clear instructions</h3>
                <p>Each listing outlines what the project involves, who it serves, and how volunteers can prepare before they arrive.</p>
            </article>
            <article class="info-card">
                <h3>Trusted partners</h3>
                <p>We work with organizations that are ready to welcome volunteers and communicate expectations clearly.</p>
            </article>
            <article class="info-card">
                <h3>Meaningful impact</h3>
                <p>Projects are selected because they support real community needs and give volunteers a direct way to contribute.</p>
            </article>
        </div>
    </section>

    <section class="cta-banner cta-banner--compact">
        <h2>Want help finding the right fit?</h2>
        <p>Explore categories to narrow your options or contact our team if you need guidance choosing a project that suits your schedule.</p>
        <a href="/categories" class="btn-secondary">View Categories</a>
    </section>
</main>

<%- include('partials/footer') %>
