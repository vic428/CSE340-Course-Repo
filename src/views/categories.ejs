<%- include('partials/header') %>

<main class="page page-categories">
    <%- include('partials/page-banner', {
        title,
        eyebrow: 'Volunteer Categories',
        subtitle: 'Explore service areas designed to help you find projects that match your interests, your skills, and the needs of your community.',
        bannerClass: 'page-banner--categories'
    }) %>

    <section class="content-intro">
        <h2>Find a cause that fits your strengths</h2>
        <p class="lead">Our opportunities are organized into focused categories so volunteers can quickly discover where they want to serve and how they can contribute.</p>
        <p>Whether you enjoy hands-on outdoor work, mentoring others, supporting neighborhood outreach, or improving community wellbeing, there is a place to start.</p>
        <p><a href="/new-category">Add a New Category</a></p>
    </section>

    <section class="category-grid">
        <% if (categories.length > 0) { %>
            <% categories.forEach((category) => { %>
                <article class="category-card">
                    <h3><a href="/category/<%= category.category_id %>"><%= category.name %></a></h3>
                </article>
            <% }); %>
        <% } else { %>
            <p>No categories are currently available.</p>
        <% } %>
    </section>

    <section class="section-panel">
        <h2>Not sure where to begin?</h2>
        <div class="info-grid">
            <article class="info-card">
                <h3>Start with your availability</h3>
                <p>Choose projects that fit the time you can realistically give, whether that is a single event or an ongoing commitment.</p>
            </article>
            <article class="info-card">
                <h3>Match your skills</h3>
                <p>Look for categories where your strengths can be immediately useful, from organizing and mentoring to physical support tasks.</p>
            </article>
            <article class="info-card">
                <h3>Follow your interests</h3>
                <p>Volunteering is more sustainable when you serve in areas you genuinely care about and want to keep returning to.</p>
            </article>
        </div>
    </section>

    <section class="cta-banner cta-banner--compact">
        <h2>Ready to explore real opportunities?</h2>
        <p>Browse our current project listings to find a service opportunity that matches the category you care about most.</p>
        <a href="/projects" class="btn-primary">Browse Projects</a>
    </section>
</main>

<%- include('partials/footer') %>
